    "guideline: Specific ammo dies, shell holders, and plates, are...": {
      "type": "guideline",
      "page": "page_2",
      "description": "Specific ammo dies, shell holders, and plates, are prohibited because they are intended to be used for pistol and assault rifle caliber products."
    },
    "rule: policy_rule - Ammunition dies plates only pr... (PROHIBITS)": {
      "type": "rule",
      "page": "page_2",
      "description": "Ammunition dies plates only prohibit the following calibers: .223, 224, 25, 5.7, 32, 357, 380, 40, 44, 45, 460, 480 judge, 5.56mm, 7.62x39mm, 9mm, 300 Blackout.",
      "status": "PROHIBITS",
      "rule_type": "policy_rule"
    },
    "rule: policy_rule - Shell holders and plates only ... (PROHIBITS)": {
      "type": "rule",
      "page": "page_2",
      "description": "Shell holders and plates only prohibit the following law calibers (from off channel): .223, 224, 25, 5.7, 32, 357, 380, 40, 44, 45, 460, 480 judge, 5.56mm, 7.62x39mm, 9mm, 300 Blackout.",
      "status": "PROHIBITS",
      "rule_type": "policy_rule"
    },
    "rule: policy_rule - Ammunition dies not listed wit... (ALLOWS)": {
      "type": "rule",
      "page": "page_2",
      "description": "Ammunition dies not listed within the prohibited section are allowed.",
      "status": "ALLOWS",
      "rule_type": "policy_rule"
    },
    "rule: policy_rule - Shell holders for firearms are... (ALLOWS)": {
      "type": "rule",
      "page": "page_2",
      "description": "Shell holders for firearms are allowed.",
      "status": "ALLOWS",
      "rule_type": "policy_rule"
    },
    "rule: policy_rule - Cleaning brushes for firearms ... (ALLOWS)": {
      "type": "rule",
      "page": "page_2",
      "description": "Cleaning brushes for firearms are allowed.",
      "status": "ALLOWS",
      "rule_type": "policy_rule"
    },
    "rule: policy_rule - Reloading kit items such as bu... (ALLOWS)": {
      "type": "rule",
      "page": "page_2",
      "description": "Reloading kit items such as bullet pullers, case trimmers, case tumblers, cleaning brushes, depriming and priming tools, hand presses, neck turners, speed loaders and sifters, and sandbags are allowed.",
      "status": "ALLOWS",
      "rule_type": "policy_rule"
    },
